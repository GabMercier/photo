---
/**
 * Header Component
 *
 * Floating liquid-glass navigation (iOS 26 style):
 * - Glass dot logo on the left
 * - Floating pill nav + language chip on the right
 * - A "lens" that slides between nav items and magnifies the one under it
 * - Scroll edge fade instead of a full-width bar
 * - One nav at every width (Reddit-style): equal-width segments,
 *   labels drop below 600px leaving icon tabs; no hamburger/overlay
 *
 * Material tiers (gated by a JS engine class, not @supports — every engine
 * claims to parse backdrop-filter: url() but only Chromium renders it):
 * - Chromium: SVG displacement refraction via backdrop-filter: var(--lg)
 * - Safari/Firefox: frosted glass (blur + saturate), same geometry
 * - prefers-contrast / prefers-reduced-transparency: near-opaque surfaces
 */
import { getLocaleFromUrl, t, localePath, alternateLocalePath } from '@utils/i18n';
import { hasPublishedProjects } from '@utils/projects';

const locale = getLocaleFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Projects appear in the nav once at least one published project exists
const hasProjects = await hasPublishedProjects();

// Navigation links — icons are inline line-art (24 viewBox, stroke 2) in the
// same stroke language as the glass text
const navLinks = [
  { key: 'nav.feed', path: '/feed', icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M7 20h10"/>' },
  { key: 'nav.gallery', path: '/gallery', icon: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>' },
  ...(hasProjects ? [{ key: 'nav.projects', path: '/projects', icon: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' }] : []),
  { key: 'nav.about', path: '/about', icon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11.5v4.5"/><path d="M12 8h.01"/>' },
];

/**
 * Check if a nav link is the current page.
 * Handles both /feed and /fr/feed cases.
 */
function isActive(linkPath: string): boolean {
  const localized = localePath(linkPath, locale);
  return currentPath === localized || currentPath === localized + '/' || currentPath.startsWith(localized + '/');
}
---

<header class="header" id="site-header">
  <!-- Scroll edge fade — content dissolves toward the top of the viewport -->
  <div class="header__edge" aria-hidden="true"></div>

  <div class="header__inner container">
    <!-- Logo — glass dome dot -->
    <a href={localePath('/', locale)} class="header__logo" aria-label="Home">
      <span class="logo__dot" data-lg="dome" aria-hidden="true"></span>
    </a>

    <!-- Desktop navigation: floating glass pill.
         The lens is a SIBLING of the nav, not a child: an element with
         backdrop-filter is a backdrop root, so a lens nested inside the
         pill would only see the pill's own (mostly transparent) pixels. -->
    <div class="header__navwrap">
      <nav class="header__pill glassy" data-lg="pill" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={localePath(link.path, locale)}
            class:list={['header__link', { 'header__link--active': isActive(link.path) }]}
            aria-label={t(link.key, locale)}
          >
            <svg class="header__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={link.icon} />
            <span class="header__label">{t(link.key, locale)}</span>
          </a>
        ))}
      </nav>
      <span class="header__lens glassy" data-lg="lens" aria-hidden="true"></span>
    </div>

    <!-- Language switcher — quiet text toggle, no glass -->
    <nav class="header__lang" aria-label="Language">
      <span class="header__lang-current">{locale.toUpperCase()}</span>
      <span class="header__lang-sep" aria-hidden="true">/</span>
      <a href={alternateLocalePath(Astro.url)} class="header__lang-alt" aria-label="Switch language">
        {t('lang.switch', locale)}
      </a>
    </nav>

  </div>

  <!-- Displacement filters are generated into these defs at runtime (Chromium only) -->
  <svg width="0" height="0" class="header__defs" aria-hidden="true"><defs id="lg-defs"></defs></svg>
</header>

<!-- Client-side scripts for mobile menu, scroll ramp, lens, and refraction -->
<script>
  /**
   * Scroll ramp: --hs goes 0 → 1 over the first 300px of scroll.
   * CSS derives edge opacity and glass background alpha from it; the blur
   * radius itself stays fixed (animating opacity is cheap, blur is not).
   */
  function initScrollRamp(signal: AbortSignal) {
    const header = document.getElementById('site-header');
    if (!header) return;

    function update() {
      if (!header) return;
      const hs = Math.min(window.scrollY / 300, 1);
      header.style.setProperty('--hs', hs.toFixed(3));
      header.classList.toggle('header--scrolled', window.scrollY > 50);
    }

    update();
    window.addEventListener('scroll', update, { passive: true, signal });
  }

  /**
   * Rim light: the conic highlight on each glass surface leans toward the
   * pointer. On touch screens it drifts slowly with scroll instead.
   */
  function initRimLight(signal: AbortSignal) {
    const header = document.getElementById('site-header');
    if (!header) return;
    const surfaces = Array.from(header.querySelectorAll<HTMLElement>('.glassy, .logo__dot'));
    if (surfaces.length === 0) return;

    let px = window.innerWidth * 0.2;
    let py = -240;
    let raf = 0;

    function apply() {
      raf = 0;
      for (const el of surfaces) {
        const b = el.getBoundingClientRect();
        if (b.width === 0) continue;
        const angle = Math.atan2(px - (b.left + b.width / 2), -(py - (b.top + b.height / 2)));
        el.style.setProperty('--light', `${(angle * 180 / Math.PI).toFixed(1)}deg`);
      }
    }

    window.addEventListener('pointermove', (e) => {
      px = e.clientX; py = e.clientY;
      if (!raf) raf = requestAnimationFrame(apply);
    }, { passive: true, signal });

    window.addEventListener('scroll', () => {
      if (!window.matchMedia('(hover: hover)').matches) {
        px = window.innerWidth * (0.5 + 0.5 * Math.sin(window.scrollY / 500));
        py = -240;
      }
      if (!raf) raf = requestAnimationFrame(apply);
    }, { passive: true, signal });

    apply();
  }

  /**
   * Selection lens: slides between nav items (iOS 26 tab bar behavior),
   * stretches slightly while moving, and snaps back to the active page's
   * link when the pointer leaves the pill.
   */
  function initLens(signal: AbortSignal) {
    const nav = document.querySelector<HTMLElement>('.header__pill');
    const lens = document.querySelector<HTMLElement>('.header__lens');
    if (!nav || !lens) return;
    const items = Array.from(nav.querySelectorAll<HTMLAnchorElement>('.header__link'));
    if (items.length === 0) return;

    const active = nav.querySelector<HTMLAnchorElement>('.header__link--active');
    let moveTimer: ReturnType<typeof setTimeout> | null = null;

    function moveTo(a: HTMLAnchorElement, animate: boolean) {
      if (!lens) return;
      if (animate) {
        lens.classList.add('header__lens--moving');
        if (moveTimer) clearTimeout(moveTimer);
        moveTimer = setTimeout(() => lens.classList.remove('header__lens--moving'), 220);
      }
      lens.style.width = `${a.offsetWidth}px`;
      lens.style.setProperty('--lens-x', `${a.offsetLeft}px`);
      lens.style.opacity = '1';
    }

    // Initial position: the active page's link, placed without animation.
    lens.classList.add('header__lens--still');
    if (active) {
      moveTo(active, false);
    } else {
      lens.style.opacity = '0';
      if (items[0]) {
        lens.style.width = `${items[0].offsetWidth}px`;
        lens.style.setProperty('--lens-x', `${items[0].offsetLeft}px`);
      }
    }
    requestAnimationFrame(() => lens.classList.remove('header__lens--still'));

    items.forEach(a => {
      a.addEventListener('pointerenter', () => moveTo(a, true), { signal });
      a.addEventListener('focus', () => moveTo(a, true), { signal });
    });
    nav.addEventListener('pointerleave', () => {
      if (active) moveTo(active, true);
      else if (lens) lens.style.opacity = '0';
    }, { signal });
  }

  /**
   * Liquid glass refraction (Chromium only).
   *
   * Each glass surface is treated as a rounded slab whose bezel follows a
   * convex squircle profile. A vertical ray bends at the curved surface
   * (Snell, n = 1.5) and lands displaced toward the centre; that vector
   * field is baked into an R/G displacement map (a data: PNG, allowed by
   * img-src data:) feeding feDisplacementMap. R and B are displaced by
   * slightly different amounts for chromatic fringing.
   *
   * Safari drops the whole backdrop-filter when the value contains url()
   * (WebKit 245510) and Firefox silently ignores it (Mozilla 1961378), and
   * @supports reports true in all three engines, so the gate is a UA check
   * that adds .lg-refract to <html>; CSS falls back to frosted blur.
   */
  let lgObserver: ResizeObserver | null = null;

  function initRefraction() {
    // Chromium gate: userAgentData brands where available (a Blink-only API,
    // so its mere presence is a strong signal), else the UA string. iOS
    // shells (CriOS/FxiOS/EdgiOS) are WebKit underneath.
    const brands = (navigator as any).userAgentData?.brands as { brand: string }[] | undefined;
    const ua = navigator.userAgent;
    const chromium = brands
      ? brands.some(b => b.brand === 'Chromium')
      : /(Chrome|Chromium)\/\d+/.test(ua) && !/\b(CriOS|FxiOS|EdgiOS)\//.test(ua);
    const reduced = window.matchMedia('(prefers-reduced-transparency: reduce)').matches
      || window.matchMedia('(prefers-contrast: more)').matches;
    const enabled = chromium && !reduced;
    document.documentElement.classList.toggle('lg-refract', enabled);

    // Drop observers from a previous init (navigation or a11y toggle),
    // so detached headers don't accumulate.
    if (lgObserver) {
      lgObserver.disconnect();
      lgObserver = null;
    }
    if (!enabled) return;

    const header = document.getElementById('site-header');
    const defs = document.getElementById('lg-defs');
    if (!header || !defs) return;

    type Preset = { bezel: number; depth: number; zoom?: number; blur: number; sat: number; ab: number };
    const PRESETS: Record<string, Preset> = {
      pill: { bezel: 18, depth: 1.05, blur: 1.5, sat: 1.4, ab: 0.06 },
      /* Lens is flat in the middle (thin edge bend) so the stacked
         icon + label stay readable; a full dome smears them at the rim. */
      lens: { bezel: 10, depth: 0.8, zoom: 1.05, blur: 0, sat: 1.1, ab: 0.02 },
      dome: { bezel: 1e9, depth: 0.7, blur: 2, sat: 1.25, ab: 0.1 },
      chip: { bezel: 12, depth: 1.0, blur: 1.5, sat: 1.35, ab: 0.05 },
    };

    const N = 1.5;
    const profile = (t: number) => Math.pow(1 - Math.pow(1 - t, 4), 0.25);
    const slope = (t: number) => {
      const a = Math.max(0, t - 1e-3), b = Math.min(1, t + 1e-3);
      return (profile(b) - profile(a)) / (b - a);
    };

    /** Bake displacement + rim maps for a w×h slab with corner radius r. */
    function bake(w: number, h: number, r: number, o: Preset) {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const W = Math.round(w * dpr), H = Math.round(h * dpr);
      const bezel = Math.min(o.bezel, r);
      const disp = new ImageData(W, H);
      const rim = new ImageData(W, H);
      const field = new Float32Array(W * H * 2);
      let max = 0;
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const cx = (x + 0.5) / dpr - w / 2, cy = (y + 0.5) / dpr - h / 2;
        const qx = Math.abs(cx) - (w / 2 - r), qy = Math.abs(cy) - (h / 2 - r);
        const din = -(Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - r);
        if (din <= 0) continue;
        let nx = 0, ny = 0;
        if (qx > 0 && qy > 0) { const l = Math.hypot(qx, qy) || 1; nx = Math.sign(cx) * qx / l; ny = Math.sign(cy) * qy / l; }
        else if (qx > qy) nx = Math.sign(cx); else ny = Math.sign(cy);
        let fx = 0, fy = 0;
        if (din < bezel) {
          const t = din / bezel;
          const th1 = Math.atan(slope(t));
          const th2 = Math.asin(Math.sin(th1) / N);
          const mag = o.depth * profile(t) * bezel * Math.tan(th1 - th2);
          fx -= nx * mag; fy -= ny * mag;
          const i = (y * W + x) * 4;
          const edge = Math.pow(1 - t, 4);
          rim.data[i] = rim.data[i + 1] = rim.data[i + 2] = 255;
          rim.data[i + 3] = Math.round(255 * edge);
        }
        if (o.zoom) { fx -= cx * (1 - 1 / o.zoom); fy -= cy * (1 - 1 / o.zoom); }
        field[(y * W + x) * 2] = fx;
        field[(y * W + x) * 2 + 1] = fy;
        max = Math.max(max, Math.abs(fx), Math.abs(fy));
      }
      for (let k = 0; k < W * H; k++) {
        const i = k * 4;
        disp.data[i] = 128 + 127 * (max ? field[k * 2] / max : 0);
        disp.data[i + 1] = 128 + 127 * (max ? field[k * 2 + 1] / max : 0);
        disp.data[i + 2] = 128;
        disp.data[i + 3] = 255;
      }
      const toUrl = (img: ImageData) => {
        const c = document.createElement('canvas');
        c.width = W; c.height = H;
        const ctx = c.getContext('2d');
        if (!ctx) return '';
        ctx.putImageData(img, 0, 0);
        return c.toDataURL();
      };
      return { disp: toUrl(disp), rim: toUrl(rim), max };
    }

    type Maps = { disp: string; rim: string; max: number };
    function filterMarkup(id: string, w: number, h: number, m: Maps, o: Preset) {
      const S = 2 * m.max; // feDisplacementMap offset = scale * (C - 0.5)
      const ch = (k: number, keep: 'r' | 'g' | 'b') => `
        <feDisplacementMap in="soft" in2="map" scale="${(S * k).toFixed(2)}" xChannelSelector="R" yChannelSelector="G" result="d${keep}"/>
        <feColorMatrix in="d${keep}" type="matrix" values="${keep === 'r' ? 1 : 0} 0 0 0 0  0 ${keep === 'g' ? 1 : 0} 0 0 0  0 0 ${keep === 'b' ? 1 : 0} 0 0  0 0 0 1 0" result="c${keep}"/>`;
      return `
      <filter id="${id}" x="0" y="0" width="${w}" height="${h}" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
        <feGaussianBlur in="SourceGraphic" stdDeviation="${o.blur}" result="soft"/>
        <feImage href="${m.disp}" x="0" y="0" width="${w}" height="${h}" preserveAspectRatio="none" result="map"/>
        ${ch(1 + o.ab, 'r')}${ch(1, 'g')}${ch(1 - o.ab, 'b')}
        <feComposite in="cr" in2="cg" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="rg"/>
        <feComposite in="rg" in2="cb" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="rgb"/>
        <feColorMatrix in="rgb" type="saturate" values="${o.sat}" result="sat"/>
        <feImage href="${m.rim}" x="0" y="0" width="${w}" height="${h}" preserveAspectRatio="none" result="rim"/>
        <feComponentTransfer in="rim" result="rimA"><feFuncA type="linear" slope="0.22" intercept="0"/></feComponentTransfer>
        <feBlend in="rimA" in2="sat" mode="screen"/>
      </filter>`;
    }

    let seq = 0;
    function build(el: HTMLElement) {
      if (!defs) return;
      const kind = el.dataset.lg || 'chip';
      const o = PRESETS[kind];
      const w = el.offsetWidth, h = el.offsetHeight;
      if (!o || w === 0 || h === 0) return;
      const br = getComputedStyle(el).borderTopLeftRadius;
      const r = Math.min(br.endsWith('%') ? Math.min(w, h) / 2 : parseFloat(br) || 0, w / 2, h / 2);
      const m = bake(w, h, r, o);
      if (!m.disp) return;
      const id = el.dataset.lgId || (el.dataset.lgId = `lgh-${kind}-${++seq}`);
      const old = defs.querySelector(`#${id}`);
      if (old) old.remove();
      defs.insertAdjacentHTML('beforeend', filterMarkup(id, w, h, m, o));
      el.style.setProperty('--lg', `url(#${id})`);
    }

    const targets = Array.from(header.querySelectorAll<HTMLElement>('[data-lg]'));
    lgObserver = new ResizeObserver(entries => {
      for (const entry of entries) build(entry.target as HTMLElement);
    });
    targets.forEach(el => lgObserver && lgObserver.observe(el));
  }

  let abort: AbortController | null = null;

  function initHeader() {
    if (abort) abort.abort();
    abort = new AbortController();
    initScrollRamp(abort.signal);
    initRimLight(abort.signal);
    initLens(abort.signal);
    initRefraction();
  }

  // Initialize on first load
  initHeader();

  // Re-initialize after Astro View Transitions swap (the header DOM is replaced)
  document.addEventListener('astro:after-swap', initHeader);

  // Contrast / transparency are live OS settings: re-evaluate the refraction
  // tier when they flip mid-session (the CSS tiers react on their own).
  for (const q of ['(prefers-reduced-transparency: reduce)', '(prefers-contrast: more)']) {
    window.matchMedia(q).addEventListener('change', () => initRefraction());
  }
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-header);
    /* The header is floating islands, not a bar: the space between them
       must not intercept clicks on the content below. */
    pointer-events: none;
    --hs: 0;
  }

  /* ================================== */
  /* Scroll edge fade                   */
  /* ================================== */
  .header__edge {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(100% + 28px);
    pointer-events: none;
    z-index: 0;
    backdrop-filter: blur(8px) saturate(150%);
    /* A whisper of the photo accent bleeds into the edge, over the bg fade */
    background:
      linear-gradient(
        to bottom,
        oklch(0.6 calc(var(--chroma-raw, 0.02) * 1.1) var(--color-accent-hue) / calc(var(--chroma-raw, 0.02) * 0.3)),
        transparent 75%
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--color-bg) 55%, transparent),
        color-mix(in oklab, var(--color-bg) 18%, transparent) 55%,
        transparent
      );
    mask-image: linear-gradient(to bottom, black 0%, black 50%, transparent 100%);
    /* Fades in with scroll; opacity also fades the filtered backdrop, which
       is much cheaper than animating the blur radius. */
    opacity: calc(0.45 + 0.55 * var(--hs));
  }

  .header__inner {
    display: flex;
    align-items: center;
    height: 100%;
    position: relative;
    z-index: 2;
    max-width: none;
    padding-inline: var(--space-md);
    gap: var(--space-sm);
    pointer-events: none;
  }

  .header__inner > * {
    pointer-events: auto;
  }

  /* ================================== */
  /* Glass material (shared surfaces)   */
  /* ================================== */
  .glassy {
    position: relative;
    border-radius: 999px;
    /* Accent wash (scaled by --chroma-raw, so B&W pages stay neutral)
       over the translucent white surface — kept faint and a touch deep
       so the photo, not the bar, carries the color */
    background:
      linear-gradient(
        oklch(0.65 calc(var(--chroma-raw, 0.02) * 1.1) var(--color-accent-hue) / calc(var(--chroma-raw, 0.02) * 0.35)),
        oklch(0.65 calc(var(--chroma-raw, 0.02) * 1.1) var(--color-accent-hue) / calc(var(--chroma-raw, 0.02) * 0.35))
      ),
      rgb(255 255 255 / calc(0.028 + 0.03 * var(--hs, 0)));
    box-shadow:
      0 4px 14px rgb(0 0 0 / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    /* Frosted tier — every engine. Chromium swaps in --lg (refraction). */
    backdrop-filter: blur(14px) saturate(150%);
  }

  :global(html.lg-refract) .glassy {
    backdrop-filter: var(--lg, blur(14px) saturate(150%));
  }

  /* Interior of the glass: a sheen on the lit side (follows --light, like
     the rim), a soft shade pooling at the bottom for thickness, and a slow
     periodic light sweep across the surface. Kept dim on purpose. */
  .glassy::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 0;
    background:
      linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 0.05) 50%, transparent 58%) no-repeat -80% 0 / 260% 100%,
      linear-gradient(var(--light, 315deg), rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015) 38%, transparent 62%),
      linear-gradient(to top, rgb(0 0 0 / 0.09), transparent 32%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .glassy::before {
      animation: glass-sweep 11s ease-in-out infinite;
    }
  }

  @keyframes glass-sweep {
    0%, 72% {
      background-position: -80% 0, 0 0, 0 0;
    }
    88%, 100% {
      background-position: 180% 0, 0 0, 0 0;
    }
  }

  /* Rim light — follows the pointer via --light (set by JS).
     Kept thin and quiet: it should read as an edge, not an outline. */
  .glassy::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 0.75px;
    pointer-events: none;
    /* Bright stops pick up the photo accent (neutral when chroma is 0) */
    background: conic-gradient(
      from var(--light, 315deg),
      oklch(0.92 calc(var(--chroma-raw, 0.02) * 1.1) var(--color-accent-hue) / 0.32),
      oklch(0.88 calc(var(--chroma-raw, 0.02) * 0.9) var(--color-accent-hue) / 0.08) 45deg,
      rgb(255 255 255 / 0.03) 120deg,
      oklch(0.9 calc(var(--chroma-raw, 0.02) * 1) var(--color-accent-hue) / 0.16) 180deg,
      rgb(255 255 255 / 0.03) 240deg,
      oklch(0.88 calc(var(--chroma-raw, 0.02) * 0.9) var(--color-accent-hue) / 0.08) 315deg,
      oklch(0.92 calc(var(--chroma-raw, 0.02) * 1.1) var(--color-accent-hue) / 0.32)
    );
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0.45;
  }

  /* ================================== */
  /* Logo — glass dome dot              */
  /* Chroma scales with --chroma-raw (0 for B&W images) */
  /* ================================== */
  .header__logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: var(--space-xs);
  }

  .logo__dot {
    display: block;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    position: relative;
    border-radius: 50%;
    overflow: hidden;

    /* Hollow glass - subtle translucent center */
    background: radial-gradient(
      circle at center,
      oklch(0.81 calc(var(--chroma-raw, 0.02) * 1) var(--color-accent-hue) / 0.03) 0%,
      oklch(0.75 calc(var(--chroma-raw, 0.02) * 1.33) var(--color-accent-hue) / 0.08) 70%,
      oklch(0.69 calc(var(--chroma-raw, 0.02) * 1.5) var(--color-accent-hue) / 0.12) 100%
    );

    /* Crisp glass rim — thin, in step with the pill's rim light */
    border: 1px solid oklch(0.78 calc(var(--chroma-raw, 0.02) * 1) var(--color-accent-hue) / 0.65);

    /* Subtle glow */
